# Copy this file to `.env` and replace the values.
# NEVER commit real secrets.

PROJECT_NAME=AI Software Architect
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
DATABASE_URL=sqlite:///./ai_architect.db
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]
